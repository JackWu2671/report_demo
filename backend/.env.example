# 环境变量模板 — 复制为 .env 并填写真实值
# .env 已在 .gitignore 中，不会提交到仓库

# LLM 配置
LLM_BASE_URL=https://<HOST>:<PORT>/v1
LLM_MODEL_NAME=                        # 例: qwen3.6-27b
LLM_TEMPERATURE=0.1
LLM_TOP_P=1.0
LLM_TIMEOUT=300
LLM_API_KEY=EMPTY
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=4096                    # 单次调用最大输出 token 数（不含思考内容）；
                                        # 若服务端忽略 LLM_ENABLE_THINKING 仍返回大量思考内容，
                                        # 可调大此值给正式回答留出空间

# Embedding 配置
EMBEDDING_BASE_URL=https://<HOST>:<PORT>
EMBEDDING_DIM=1024                     # bge-m3 为 1024

# FAISS 检索阈值（余弦相似度，范围 0~1，越低召回越多）
FAISS_SCORE_THRESHOLD=0.5

# 调试开关：设为 true 时跳过真实 SQL，直接使用 mock_data（方便本地测试）
FORCE_MOCK=false

# 会话产物根目录（大纲/报告三视图落盘位置：<REPORT_DATA_DIR>/report/<session_id>/）
# 不设置时默认 backend/data。留空字符串等同不设置——如需自定义，取消注释并填写绝对路径
# REPORT_DATA_DIR=/path/to/data
